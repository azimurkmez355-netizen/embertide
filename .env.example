# Firebase web app config — Firebase Console > Project settings > General > Your apps > SDK setup and configuration
# Copy this file to .env and fill in your own project's values. These are safe to expose client-side;
# access is restricted by the Realtime Database rules in database.rules.json, not by key secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
